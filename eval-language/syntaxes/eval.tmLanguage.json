{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Eval",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#logical-operators"
    },
    {
      "include": "#differentiation"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#variables"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.eval",
          "match": "--.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.eval",
          "match": "\\b(if|then|else|fun|lambda)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.eval",
          "match": "\\b(int|bool|any)\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.eval",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "logical-operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.eval",
          "match": "(&&|\\|\\||!)"
        }
      ]
    },
    "differentiation": {
      "patterns": [
        {
          "name": "keyword.operator.derivative.eval",
          "match": "`"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.eval",
          "match": "(::|\\.\\.\\.|->|<=|>=|==|\\^|\\*|/|%|\\+|\\-|<|>|=|;|\\?|\\||\\.|@|:)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.definition.eval",
          "match": "([\\(\\)\\[\\]\\{\\},])"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.eval",
          "match": "-?\\b[0-9]+\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.eval",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  },
  "scopeName": "source.eval"
}

