filter (l : [any]) (f : (any -> bool)) : [any] = ? l {
  | [] -> []
  | h::t -> if f.h
    then h::(filter.t.f)
    else filter.t.f
};

sort (l : [int]) : [int] = ? l {
  | [] -> []
  | p::rest ->
    left = filter.rest.(lambda x : int -> x < p);
    right = filter.rest.(lambda x : int -> x >= p);
    sort.left @ [p] @ sort.right
};

sort.[5,3,29,2,23,41,10,1]