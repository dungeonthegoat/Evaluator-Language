let untyped map f l =
    if null l
    then []
    else f head l :: map f tail l;

let untyped filter f l =
    if null l
    then []
    else
        if f head l
        then head l :: filter f tail l
        else filter f tail l ;

let untyped foldr f l i =
    if null l
    then i
    else f (head l) (foldr f (tail l) i);

let untyped add x y = x + y;

let nums = [1...10];

